{
  "name": "switchyard",
  "version": "0.1.0",
  "description": "The operations layer for Switch: inlets, flows and outlets for agent rooms.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
