# Written by `switchyard register`:
SWITCHYARD_AGENT_ID=
SWITCHYARD_API_KEY=
# Only needed once, for `switchyard register` (a personal API key from Switch Console):
SWITCH_REGISTRATION_TOKEN=
# Only for a real mail server; Mailpit needs none:
SMTP_USER=
SMTP_PASS=
# The invoice webhook's HMAC secret: senders sign the body with it
# (X-Switchyard-Signature: sha256=<hmac>). Any long random string, e.g.
# `openssl rand -hex 32`. Without it every invoice is refused.
INVOICE_HOOK_SECRET=
# `switchyard setup-local` also writes <AGENT>_ID and <AGENT>_KEY here for each
# agent it registers. It reads SWITCH_ADMIN_EMAIL / SWITCH_ADMIN_PASSWORD from
# the environment of that one command; they are never stored.
